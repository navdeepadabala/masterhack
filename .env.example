# Argus — Oracle (LLM narrative layer) configuration
# Copy this file to .env and fill in the key you want to use.
# Oracle degrades gracefully to static templates when this is unset.

# ---- Provider A: Anthropic (Claude) ----
# LLMM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Provider B: OpenAI (GPT) ----
# LLMM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ---- Provider C: Google (Gemini) ----
# LLMM_PROVIDER=google
# GEMINI_API_KEY=AIza...

# Optional: model overrides
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro

# Optional: per-request caching (seconds). 0 disables caching.
# ORACLE_CACHE_TTL=600
# ORACLE_CACHE_MAX_ENTRIES=256